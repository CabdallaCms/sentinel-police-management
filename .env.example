# Sentinel backend — PostgreSQL engine settings.
#
# Copy this file to `.env` (same directory) and adjust the values for your
# local PostgreSQL instance. The backend loads it at startup with a small
# standard-library reader (see `load_env_file()` in backend/server.py), so no
# extra packages are required. Real environment variables always work too —
# the .env file simply seeds them.

SENTINEL_DB_NAME=sentinel_police
SENTINEL_DB_USER=postgres
SENTINEL_DB_PASSWORD=change-me
SENTINEL_DB_HOST=localhost
SENTINEL_DB_PORT=5432

# HTTP port the API + UI listen on (default 8001)
# PORT=8001
